# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=production
# Public URL of the site (used for the Origin check on POST requests).
# Leave blank to accept same-host requests only.
PUBLIC_URL=https://reports.example.com
# Random secret, 32+ chars. Signs/encrypts session data. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=
# Number of reverse proxies in front of the app (Render/Railway/Heroku = 1,
# Cloudflare + host = 2, bare VPS = 0). Needed for correct client IPs.
TRUST_PROXY=1

# --- Lemon Squeezy -----------------------------------------------------------
# API key from Lemon Squeezy > Settings > API. Needed to LIST the devices on a
# key (the public License API can't) and to look up the order number/refund state.
LEMON_SQUEEZY_API_KEY=eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..dchfoRAr-UlyMVByrOOYUra1BN8lXSMhhn9ejNhWpHEQZtTAE3ThAtE6ViHoaEEPay3ZRi-jCH7w7Hg6GTJfudpgKd8D0WHyySacsc_IHHFlmmeAtxZONuzEQP0MBP6_gm9Fod21I4UbxrKKw6QAkuvjL3FTe_6rfSIbjZbyDZcLRnwIfBxpr_YvcrJTUCqgQO_X--D7Er53y5RN0sAugX4TgKGySK5Wir4lel04zV8DEhg1dbvMBiL3iTzlbULLdVR5eisZPat1dq5UXDgd84I0p-NlICskkT_8vYBLQKLLIVqWrDi-niulV46RTFllIuOweCJm3rDJ-HuqY7zts3cispmGKSZLUu8xLz9BnpqGtjVeteGKtsExxEwjoX4v6Gx9dFKbhtmVUT2jd1Tx_EULqEVuX0zeZsMeSJbin_y5-sreshuqqmsnjyGdUp60AJZoo0kx95dkASLlmvkfzclmHGcYvKVpjcwVCm6Hb1qXoOuQit5xr4qx72WBCRGMGGx_mtDBHErSpBYxAcc_VkJTw6XRm09wC2TbxbAKC7mgV_x2mvAj123t-FFf7_9yDuRsYx7al8z2SpC6qRWXVaV4fVHcEc3x7hKelPOU-1oJ4NunFiEeF9xFrOtErYNI0RsDqfpMyzd2ETw2oaPClbpoW4TDLB5wJpv419zbrHs
# Webhook signing secret (Settings > Webhooks). Lets refunds/disabled keys lock
# readers out immediately instead of at the next 7-day re-check.
# Webhook URL to register: https://<your-domain>/api/webhooks/lemonsqueezy
# Events: license_key_created, license_key_updated, order_refunded
LEMON_WEBHOOK_SECRET=
# Only keys from THIS store/product/variant(s) are accepted.
STORE_ID=
PRODUCT_ID=
# One variant ID per tier, comma separated (e.g. Solo,Team). The device limit for
# each tier is the "activation limit" you set on that variant in Lemon Squeezy.
VARIANT_IDS=
# Set to true only while testing with Lemon Squeezy test-mode keys.
ALLOW_TEST_MODE_KEYS=false

# --- Report ------------------------------------------------------------------
REPORT_TITLE=Confidential Market Report
# PDF stays on the server (never in /public). Falls back to generated
# placeholder pages if the file doesn't exist.
REPORT_PDF_PATH=storage/report.pdf
# Pixel width of the page images sent to readers.
RENDER_WIDTH=1200
SUPPORT_EMAIL=support@example.com

# --- Policy (defaults match the brief) --------------------------------------
SESSION_DAYS=30
REVALIDATE_DAYS=7
# If Lemon Squeezy is unreachable when a re-check is due, keep serving for this
# many hours before locking the reader out.
REVALIDATE_GRACE_HOURS=24
MAX_REMOVALS=2
REMOVAL_WINDOW_DAYS=30
