# Local development against the built-in mock Lemon Squeezy API.
# Used by: npm run dev:mock / npm start:mock / npm test
# The mock refuses to start when NODE_ENV=production.
NODE_ENV=development
PORT=3000
MOCK_LEMON=true
SESSION_SECRET=local-dev-secret-local-dev-secret-0123456789
TRUST_PROXY=0

STORE_ID=1111
PRODUCT_ID=2222
VARIANT_IDS=3333,4444
ALLOW_TEST_MODE_KEYS=true

# Matches the mock's webhook helper so you can try refund events locally.
LEMON_WEBHOOK_SECRET=mock-webhook-secret
LEMON_SQUEEZY_API_KEY=mock-api-key

REPORT_TITLE=Confidential Market Report (Demo)
REPORT_PDF_PATH=storage/report.pdf
RENDER_WIDTH=1200
SUPPORT_EMAIL=support@example.com
